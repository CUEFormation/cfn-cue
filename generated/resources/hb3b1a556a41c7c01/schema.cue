#VCpuCountRange: close({
	Max?: int & <=10000 & >=1 |
		{
			string &
				=~"^[[:space:]]*[+-]?[0-9](?:_?[0-9])*[[:space:]]*$" &
				cfnScalarStrings.Repeat(
					self,
					len(cfnScalarStrconv.FormatInt(
						cfnScalarStrconv.Atoi(cfnScalarStrings.Replace(cfnScalarStrings.TrimSpace(self), "_", "", -1)) &
							int &
							<=10000 &
							>=1,
						10,
					))*0 + 1,
				)
		} |
		fn.#NumberExpression
	Min!: int & <=10000 & >=1 |
		{
			string &
				=~"^[[:space:]]*[+-]?[0-9](?:_?[0-9])*[[:space:]]*$" &
				cfnScalarStrings.Repeat(
					self,
					len(cfnScalarStrconv.FormatInt(
						cfnScalarStrconv.Atoi(cfnScalarStrings.Replace(cfnScalarStrings.TrimSpace(self), "_", "", -1)) &
							int &
							<=10000 &
							>=1,
						10,
					))*0 + 1,
				)
		} |
		fn.#NumberExpression
}) |
fn.#ObjectExpression

