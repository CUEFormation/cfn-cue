		[=~"^[a-zA-Z0-9\\s._:/=+@-]{1,128}$"]: strings.MaxRunes(256) &
		strings.MinRunes(0) &
		=~"^[a-zA-Z0-9\\s._:/=+@-]*$" |
		{
			number | bool
			_cfnString: strings.MaxRunes(256) & strings.MinRunes(0) & =~"^[a-zA-Z0-9\\s._:/=+@-]*$" & "\(self)"
		} |
		fn.#StringExpression
	}
}) |
fn.#ObjectExpression

#TargetConfiguration: matchN(1, [close(
	{Mcp!: #McpTargetConfiguration},
), close(
	{Http!: #HttpTargetConfiguration},
), close(
	{Inference!: #InferenceTargetConfiguration},
)]) |
fn.#ValueExpression

#ToolDefinition: close({
	Description!:  string | number | bool | fn.#StringExpression
	InputSchema!:  #SchemaDefinition
	Name!:         string | number | bool | fn.#StringExpression
	OutputSchema?: #SchemaDefinition
}) |
fn.#ObjectExpression

#ToolSchema: matchN(1, [
	close({S3!: #S3Configuration}), close({InlinePayload!: [...#ToolDefinition] | fn.#ListExpression}),
]) |
fn.#ValueExpression
