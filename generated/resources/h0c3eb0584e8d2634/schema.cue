					len(cfnScalarStrconv.FormatInt(
						cfnScalarStrconv.Atoi(cfnScalarStrings.Replace(cfnScalarStrings.TrimSpace(self), "_", "", -1)) &
							int,
						10,
					))*0 + 1,
				)
		} |
		fn.#NumberExpression
}) |
fn.#ObjectExpression
