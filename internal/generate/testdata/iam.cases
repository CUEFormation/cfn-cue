# IAM profile cases: want<TAB>definition<TAB>CUE value. Run by TestIAMProfiles.
# Identity
ok	#IdentityPolicy	{Version: "2012-10-17", Statement: [{Effect: "Allow", Action: "s3:GetObject", Resource: "arn:aws:s3:::b/*"}]}
ok	#IdentityPolicy	{Statement: {Effect: "Allow", Action: ["s3:Get*", "s3:List?ucket"], Resource: "*"}}
ok	#IdentityPolicy	{Statement: [{Effect: "Deny", NotAction: "iam:*", NotResource: {"Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/x"}}]}
ok	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: {Ref: "ActionParam"}, Resource: {"Fn::GetAtt": ["Bucket", "Arn"]}}]}
ok	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: {Ref: "ActionList"}, Resource: "*"}]}
ok	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3:GetObject", Resource: "*", Condition: {StringEquals: {"aws:PrincipalTag/Team": "a"}, "ForAnyValue:StringLikeIfExists": {"aws:TagKeys": ["x", "y"]}, Bool: {"aws:SecureTransport": false}, NumericLessThanEquals: {"s3:max-keys": 10}, Null: {"aws:TokenIssueTime": "true"}}}]}
ok	#IdentityPolicy	{Statement: [{"Fn::If": ["Cond", {Effect: "Allow", Action: "s3:*", Resource: "*"}, {Ref: "AWS::NoValue"}]}]}
ok	#IdentityPolicy	{Statement: [{Ref: "AWS::NoValue"}, {Effect: "Allow", Action: "s3:*", Resource: "*"}]}
# Fn::If over a whole statement list is not accepted.
bad	#IdentityPolicy	{Statement: {"Fn::If": ["Cond", [{Effect: "Allow", Action: "s3:*", Resource: "*"}], []]}}
bad	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3:*", Resource: "*", Principal: "*"}]}
bad	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3:*"}]}
bad	#IdentityPolicy	{Statement: [{Effect: "Allow", Resource: "*"}]}
bad	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3:*", NotAction: "s3:Get*", Resource: "*"}]}
bad	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3:*", Resource: "*", NotResource: "*"}]}
bad	#IdentityPolicy	{Statement: [{Effect: "allow", Action: "s3:*", Resource: "*"}]}
bad	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3GetObject", Resource: "*"}]}
bad	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3:*", Resource: "bucket/*"}]}
bad	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3:*", Resource: "*", Sid: "has space"}]}
bad	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3:*", Resource: "*", Bogus: 1}]}
bad	#IdentityPolicy	{Version: "2012-10-18", Statement: [{Effect: "Allow", Action: "s3:*", Resource: "*"}]}
bad	#IdentityPolicy	{Statements: [{Effect: "Allow", Action: "s3:*", Resource: "*"}]}
bad	#IdentityPolicy	{Version: "2012-10-17"}
bad	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3:*", Resource: "*", Condition: {StringEqual: {"aws:x": "a"}}}]}
bad	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3:*", Resource: "*", Condition: {NullIfExists: {"aws:x": "a"}}}]}
bad	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3:*", Resource: "*", Condition: {StringEquals: {"nokey": "a"}}}]}
bad	#IdentityPolicy	{Statement: [{"Fn::If": ["Cond", {Effect: "Allow", Action: "s3:*"}, {Ref: "AWS::NoValue"}]}]}
