ok	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: ["s3:GetObject", "{{resolve:ssm:PolicyAction:1}}"], Resource: ["{{resolve:ssm:PolicyResource:1}}"]}]}
ok	#TrustPolicy	{Statement: [{Effect: "Allow", Principal: "*", Action: ["{{resolve:ssm:TrustAction}}"]}]}
