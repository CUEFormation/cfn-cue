ok	#ResourcePolicyValue	{"Fn::If": ["C", {Statement: [{Effect: "Allow", Principal: "*", Action: "sqs:*", Resource: "*"}]}, "{\"Statement\":[{\"Effect\":\"Allow\",\"Principal\":\"*\",\"Action\":\"sqs:*\",\"Resource\":\"*\"}]}"]}
ok	#ResourcePolicyValue	{"Fn::If": ["C", {Ref: "PolicyParam"}, {Statement: [{Effect: "Allow", Principal: "*", Action: "sqs:*", Resource: "*"}]}]}
ok	#IdentityPolicyValue	{"Fn::If": ["C", {Statement: [{Effect: "Allow", Action: "s3:*", Resource: "*"}]}, {"Fn::Sub": "{\"Statement\": []}"}]}
