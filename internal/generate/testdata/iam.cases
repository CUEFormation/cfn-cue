# Only Allow statements are restricted to Resource "*"; NotResource is not.
ok	#ServiceControlPolicy	{Statement: [{Effect: "Allow", Action: "ec2:*", NotResource: "arn:aws:ec2:*:*:instance/*"}]}
bad	#ServiceControlPolicy	{Statement: [{Effect: "Allow", Action: "ec2:*", Resource: ["*", "arn:aws:ec2:*:*:instance/*"]}]}
# An Fn::If condition value may return a string or a list.
ok	#IdentityPolicy	{Statement: [{Effect: "Allow", Action: "s3:*", Resource: "*", Condition: {ArnEquals: {"aws:SourceArn": {"Fn::If": ["C", {Ref: "A"}, {Ref: "B"}]}}}}]}
