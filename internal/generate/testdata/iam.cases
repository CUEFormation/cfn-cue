ok	#ResourcePolicy	{Statement: [{Effect: "Allow", Principal: {"Fn::If": ["A", {Ref: "P"}, {AWS: "123456789012"}]}, Action: "sqs:SendMessage", Resource: "*"}]}
ok	#ResourcePolicy	{Statement: [{Effect: "Allow", Principal: {"Fn::If": ["A", {Ref: "P"}, {Ref: "Q"}]}, Action: "sqs:SendMessage", Resource: "*"}]}
