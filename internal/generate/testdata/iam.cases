# Conditional statement entries and conditions nest.
ok	#ECRRepositoryPolicy	{Statement: [{Effect: "Allow", Principal: "*", Action: "ecr:BatchGetImage"}, {"Fn::If": ["A", {"Fn::If": ["B", {Effect: "Allow", Principal: "*", Action: "ecr:BatchGetImage"}, {Ref: "AWS::NoValue"}]}, {Ref: "AWS::NoValue"}]}]}
