ok	#ResourcePolicy	{Statement: [{Effect: "Allow", Principal: "*", Action: "sqs:*", Resource: "*", Condition: {ArnEquals: {"aws:SourceArn": {"Fn::If": ["C", {Ref: "A"}, {Ref: "B"}]}}}}]}
