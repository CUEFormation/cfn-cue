{
  "Conditions": {
    "Dev": {
      "Fn::Equals": [
        {
          "Ref": "Env"
        },
        "dev"
      ]
    },
    "Prod": {
      "Fn::Equals": [
        {
          "Ref": "Env"
        },
        "prod"
      ]
    }
  },
  "Parameters": {
    "Env": {
      "AllowedValues": [
        "prod",
        "dev"
      ],
      "Type": "String"
    }
  },
  "Resources": {
    "A": {
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "${AWS::StackName}-app"
        }
      },
      "Type": "AWS::Logs::LogGroup"
    },
    "B": {
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "${AWS::StackName}-app"
        }
      },
      "Type": "AWS::Logs::LogGroup"
    }
  }
}
