{
  "Conditions": {
    "Dev": {
      "Fn::Equals": [
        {
          "Ref": "Env"
        },
        "dev"
      ]
    },
    "Prod": {
      "Fn::Equals": [
        {
          "Ref": "Env"
        },
        "prod"
      ]
    }
  },
  "Parameters": {
    "Env": {
      "AllowedValues": [
        "prod",
        "dev"
      ],
      "Type": "String"
    }
  },
  "Resources": {
    "A": {
      "Properties": {
        "LogGroupName": {
          "Fn::If": [
            "Prod",
            "app",
            {
              "Ref": "AWS::NoValue"
            }
          ]
        }
      },
      "Type": "AWS::Logs::LogGroup"
    },
    "B": {
      "Properties": {
        "LogGroupName": {
          "Fn::If": [
            "Prod",
            {
              "Ref": "AWS::NoValue"
            },
            "app"
          ]
        }
      },
      "Type": "AWS::Logs::LogGroup"
    }
  }
}
