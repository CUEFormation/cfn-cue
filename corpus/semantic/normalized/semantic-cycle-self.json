{
  "Conditions": {
    "Dev": {
      "Fn::Equals": [
        {
          "Ref": "Env"
        },
        "dev"
      ]
    },
    "Prod": {
      "Fn::Equals": [
        {
          "Ref": "Env"
        },
        "prod"
      ]
    }
  },
  "Parameters": {
