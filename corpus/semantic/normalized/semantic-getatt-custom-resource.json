{
  "Resources": {
    "Provider": {
      "Properties": {
        "ServiceToken": {
          "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:provider"
        }
      },
      "Type": "Custom::Provider"
    },
    "Queue": {
      "Properties": {
        "QueueName": {
          "Fn::GetAtt": [
            "Provider",
            "Any.Attribute"
          ]
        }
      },
      "Type": "AWS::SQS::Queue"
    }
  }
}
