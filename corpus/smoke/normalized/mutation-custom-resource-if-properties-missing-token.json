{
  "Conditions": {
    "Payload": {
      "Fn::Equals": [
        {
          "Ref": "AWS::Region"
        },
        "us-west-2"
      ]
    },
    "Primary": {
      "Fn::Equals": [
        {
          "Ref": "AWS::Region"
        },
        "us-east-1"
      ]
    }
  },
  "Resources": {
    "Thing": {
      "Properties": {
        "Fn::If": [
          "Primary",
          {
            "ServiceToken": "arn:aws:lambda:us-east-1:123456789012:function:CustomResourceProvider"
          },
          {
            "Fn::If": [
              "Payload",
              {
                "Payload": [
                  1
                ]
              },
              {
                "ServiceToken": "arn:aws:lambda:us-east-1:123456789012:function:CustomResourceProvider"
              }
            ]
          }
        ]
      },
      "Type": "Custom::Thing"
    }
  }
}
