{
  "Conditions": {
    "Create": {
      "Fn::Equals": [
        {
          "Ref": "Name"
        },
        "yes"
      ]
    }
  },
  "Outputs": {
    "BucketArn": {
      "Value": {
        "Fn::GetAtt": [
          "Bucket",
          "Arn"
        ]
      }
    }
  },
  "Parameters": {
    "Name": {
      "Type": "String"
    }
  },
  "Resources": {
    "Bucket": {
      "Properties": {
        "AccessControl": {
          "Fn::If": [
            "Create",
            "Private",
            {
              "Ref": "AWS::NoValue"
            }
          ]
        },
        "Arn": "read-only",
        "BucketName": {
          "Fn::Join": [
            "-",
            [
              {
                "Fn::Sub": [
                  "${P}-bucket",
                  {
                    "P": {
                      "Ref": "Name"
                    }
                  }
                ]
              },
              {
                "Ref": "Name"
              }
            ]
          ]
        }
      },
      "Type": "AWS::S3::Bucket"
    }
  }
}
