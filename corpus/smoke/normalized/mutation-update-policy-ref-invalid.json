{
  "Conditions": {
    "Named": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "Name"
            },
            ""
          ]
        }
      ]
    }
  },
  "Parameters": {
    "Name": {
      "Type": "String"
    }
  },
  "Resources": {
    "Group": {
      "Properties": {
        "AvailabilityZones": [
          "us-east-1a"
        ],
        "LaunchTemplate": {
          "LaunchTemplateId": "lt-0123456789abcdef0",
          "Version": "1"
        },
        "MaxSize": "2",
        "MinSize": "1"
      },
      "Type": "AWS::AutoScaling::AutoScalingGroup",
      "UpdatePolicy": {
        "Ref": "Name"
      }
    }
  }
}
