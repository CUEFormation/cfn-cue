{
  "Resources": {
    "Broker": {
      "Properties": {
        "AutoMinorVersionUpgrade": true,
        "BrokerName": "test",
        "DeploymentMode": "SINGLE_INSTANCE",
        "EngineType": "RABBITMQ",
        "EngineVersion": "3.13",
        "HostInstanceType": "{{resolve:ssm:/broker/instance-type}}",
        "PubliclyAccessible": false,
        "Users": [
          {
            "Password": "{{resolve:unknown:MySecret}}",
            "Username": "test"
          }
        ]
      },
      "Type": "AWS::AmazonMQ::Broker"
    }
  }
}
